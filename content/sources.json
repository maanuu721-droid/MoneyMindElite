{
  "niches": {
    "finance_wealth": {
      "priority": "primary",
      "rss_feeds": [
        "https://www.bloomberg.com/feeds/businessweek/rss",
        "https://www.forbes.com/business/feed/",
        "https://finance.yahoo.com/news/rssindex",
        "https://www.reutersagency.com/feed/?best-topics=business&post_type=best"
      ],
      "keywords": ["wealth management", "arbitrage", "passive income", "market analysis", "financial freedom"]
    },
    "tech_ia": {
      "priority": "secondary",
      "rss_feeds": [
        "https://techcrunch.com/feed/",
        "https://www.theverge.com/rss/index.xml",
        "https://wired.com/feed/rss"
      ],
      "keywords": ["artificial intelligence", "generative ia", "automation", "saas", "tech trends"]
    },
    "lifestyle_luxury": {
      "priority": "secondary",
      "rss_feeds": [
        "https://robbreport.com/feed/",
        "https://www.gq.com/feed/rss",
        "https://www.voguebusiness.com/feed"
      ],
      "keywords": ["luxury travel", "exclusive experiences", "high-end real estate", "luxury watches", "lifestyle"]
    },
    "alpha_sources": {
      "priority": "gold_standard",
      "apis": [
        {
          "name": "SEC EDGAR",
          "endpoint": "https://data.sec.gov/submissions/CIK0000320193.json",
          "notes": "Official earnings and filings. Requires User-Agent: MoneyMindElite developer@moneymindelite.com"
        },
        {
          "name": "Bureau of Labor Statistics (BLS) v1.0",
          "endpoint": "https://api.bls.gov/publicAPI/v1/timeseries/data/",
          "notes": "No key required for v1.0. Limits apply.",
          "series_ids": {
            "inflation_cpi": "CUUR0000SA0",
            "unemployment_rate": "LNS14000000",
            "non_farm_payrolls": "CES0000000001"
          }
        },
        {
          "name": "Morningstar (RapidAPI)",
          "endpoint": "https://morningstar1.p.rapidapi.com/properties/get-details",
          "notes": "Investment fund ratings. Requires X-RapidAPI-Key."
        },
        {
          "name": "FRED (Federal Reserve Economic Data)",
          "endpoint": "https://api.stlouisfed.org/fred/series/observations",
          "notes": "Correlation goldmine. Requires api_key.",
          "key_series": {
            "fed_funds_rate": "FEDFUNDS",
            "personal_saving_rate": "PSAVERT",
            "case_shiller_home_price": "CSUSHPINSA"
          }
        },
        {
          "name": "Finnhub Stock API",
          "endpoint": "https://finnhub.io/api/v1/news",
          "notes": "Real-time market news and stock prices. Requires token.",
          "categories": ["general", "forex", "crypto", "merger"]
        },
        {
          "name": "OpenBB",
          "endpoint": "https://pro.openbb.co/api",
          "notes": "Investment research platform. Access via user's workspace/API."
        },
        {
          "name": "Glassnode",
          "endpoint": "https://api.glassnode.com/v1/metrics/",
          "notes": "Crypto on-chain data. Requires Professional Plan API key.",
          "key_metrics": ["addresses/active_count", "transactions/count", "indicators/sopr"]
        },
        {
          "name": "NewsAPI",
          "endpoint": "https://newsapi.org/v2/everything",
          "notes": "Broad breaking news across multiple domains. Requires apiKey.",
          "key_topics": ["finance", "crypto", "business", "technology"]
        }
      ]
    }
  },
  "compliance_and_limits": {
    "global_rules": {
      "copyright_enforcement": "STRICT_AI_SYNTHESIS_ONLY",
      "copyright_prompt": "Read the provided data/news. Synthesize the core facts and write a 100% original, unique article analyzing the implications. NEVER copy-paste sentences from the source.",
      "attribution_policy": "Must include 'Source: [Name]' or 'According to [Name]...' at the end of articles."
    },
    "source_specific_limits": {
      "rss_feeds": { "max_polls_per_day": 6, "scraping_allowed": false, "notes": "Extract title/description only. Highly copyrighted." },
      "sec_edgar": { "max_requests_per_second": 1, "notes": "Public domain. Requires User-Agent." },
      "bls_v1": { "max_requests_per_day": 200, "notes": "Public domain. Keep well below 250 limit." },
      "fred": { "max_requests_per_minute": 60, "notes": "Public domain. Keep below 120 RPM." },
      "finnhub": { "max_requests_per_minute": 30, "notes": "Free tier limit. Do not resell raw data." },
      "morningstar_rapidapi": { "max_requests_per_day": 5, "notes": "Protect monthly quota. Intellectual property." },
      "newsapi": { "max_requests_per_day": 50, "notes": "Developer plan limit 100/day. Must attribute NewsAPI.org." }
    }
  },
  "settings": {
    "update_frequency_hours": 6,
    "min_relevance_score": 75,
    "ai_model": "gpt-4-turbo"
  }
}
